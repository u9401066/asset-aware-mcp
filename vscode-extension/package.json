{
    "name": "asset-aware-mcp",
    "displayName": "Asset-Aware MCP",
    "description": "Medical RAG MCP Server with precise document asset retrieval and Docx editing (DFM) — tables, figures, sections from PDFs + .docx/.doc round-trip with integrity validation",
    "version": "0.6.31",
    "publisher": "u9401066",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Data Science"
    ],
    "keywords": [
        "mcp",
        "rag",
        "medical",
        "pdf",
        "documents",
        "knowledge-graph",
        "copilot",
        "ai"
    ],
    "icon": "resources/icon.png",
    "galleryBanner": {
        "color": "#16395B",
        "theme": "dark"
    },
    "badges": [
        {
            "url": "https://img.shields.io/pypi/v/asset-aware-mcp",
            "href": "https://pypi.org/project/asset-aware-mcp/",
            "description": "PyPI Version"
        }
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "asset-aware-mcp.servers",
                "label": "Asset-Aware Medical RAG"
            }
        ],
        "commands": [
            {
                "command": "assetAwareMcp.setupWizard",
                "title": "Asset-Aware MCP: Setup Wizard"
            },
            {
                "command": "assetAwareMcp.openSettings",
                "title": "Asset-Aware MCP: Open Settings Panel"
            },
            {
                "command": "assetAwareMcp.installAssistantAssets",
                "title": "Asset-Aware MCP: Install/Update Assistant Harness Assets"
            },
            {
                "command": "assetAwareMcp.configureExternalMcp",
                "title": "Asset-Aware MCP: Configure Copilot/Cline/Codex MCP"
            },
            {
                "command": "assetAwareMcp.prepareServer",
                "title": "Asset-Aware MCP: Prepare Server Runtime"
            },
            {
                "command": "assetAwareMcp.showStatus",
                "title": "Asset-Aware MCP: Show Status"
            },
            {
                "command": "assetAwareMcp.checkConnection",
                "title": "Asset-Aware MCP: Check Ollama Connection"
            },
            {
                "command": "assetAwareMcp.editEnv",
                "title": "Asset-Aware MCP: Edit .env Configuration"
            },
            {
                "command": "assetAwareMcp.refreshStatus",
                "title": "Asset-Aware MCP: Refresh Status"
            },
            {
                "command": "assetAwareMcp.checkDependencies",
                "title": "Asset-Aware MCP: Check System Dependencies"
            },
            {
                "command": "assetAwareMcp.showOutput",
                "title": "Asset-Aware MCP: Show Output Log"
            },
            {
                "command": "assetAwareMcp.upgradeServer",
                "title": "Asset-Aware MCP: Upgrade Server to Latest Version"
            },
            {
                "command": "assetAwareMcp.openTableExcel",
                "title": "Asset-Aware MCP: Open in Excel"
            },
            {
                "command": "assetAwareMcp.openDocxAsDfm",
                "title": "Asset-Aware MCP: Open DOCX as DFM (Editable Markdown)"
            },
            {
                "command": "assetAwareMcp.saveDfmToDocx",
                "title": "Asset-Aware MCP: Save DFM back to DOCX"
            },
            {
                "command": "assetAwareMcp.saveDfmToDocxAs",
                "title": "Asset-Aware MCP: Save DFM to DOCX As..."
            },
            {
                "command": "assetAwareMcp.closeDfmSession",
                "title": "Asset-Aware MCP: Close DFM Session"
            },
            {
                "command": "assetAwareMcp.listDfmSessions",
                "title": "Asset-Aware MCP: List DFM Sessions"
            }
        ],
        "configuration": {
            "title": "Asset-Aware MCP",
            "properties": {
                "assetAwareMcp.llmBackend": {
                    "type": "string",
                    "default": "ollama",
                    "enum": [
                        "ollama",
                        "openai"
                    ],
                    "description": "LLM backend to use (ollama for local, openai for cloud)"
                },
                "assetAwareMcp.ollamaHost": {
                    "type": "string",
                    "default": "http://localhost:11434",
                    "description": "Ollama server URL"
                },
                "assetAwareMcp.ollamaModel": {
                    "type": "string",
                    "default": "qwen2.5:7b",
                    "description": "Ollama LLM model name"
                },
                "assetAwareMcp.ollamaEmbeddingModel": {
                    "type": "string",
                    "default": "nomic-embed-text",
                    "description": "Ollama embedding model name"
                },
                "assetAwareMcp.openaiApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "OpenAI API Key (required if using openai backend)"
                },
                "assetAwareMcp.openaiModel": {
                    "type": "string",
                    "default": "gpt-4o-mini",
                    "description": "OpenAI model name"
                },
                "assetAwareMcp.openaiEmbeddingModel": {
                    "type": "string",
                    "default": "text-embedding-3-small",
                    "description": "OpenAI embedding model name for LightRAG"
                },
                "assetAwareMcp.dataDir": {
                    "type": "string",
                    "default": "./data",
                    "description": "Directory for storing processed documents"
                },
                "assetAwareMcp.enableMarkerBackend": {
                    "type": "boolean",
                    "default": false,
                    "description": "Reserved for the optional Marker backend. Temporarily disabled because marker-pdf pins vulnerable Pillow<11 while asset-aware-mcp requires patched Pillow>=12.2.0."
                },
                "assetAwareMcp.torchBackend": {
                    "type": "string",
                    "default": "cpu",
                    "enum": [
                        "cpu",
                        "auto"
                    ],
                    "description": "Reserved torch backend setting for Marker after its Pillow dependency supports the secure runtime."
                },
                "assetAwareMcp.installAssistantAssets": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically install/update bundled Copilot, Cline, and Codex harness assets into the active workspace."
                },
                "assetAwareMcp.installCopilotWorkspaceConfig": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically merge an Asset-Aware MCP server entry into the workspace .vscode/mcp.json for GitHub Copilot."
                },
                "assetAwareMcp.installClineConfig": {
                    "type": "boolean",
                    "default": false,
                    "description": "Force writing Cline MCP settings even if the Cline extension/global storage is not detected."
                },
                "assetAwareMcp.installCodexConfig": {
                    "type": "boolean",
                    "default": false,
                    "description": "Force writing Codex MCP settings even if CODEX_HOME or ~/.codex does not already exist."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "assetAwareMcp",
                    "title": "Asset-Aware MCP",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "assetAwareMcp": [
                {
                    "id": "assetAwareMcp.status",
                    "name": "Status",
                    "icon": "$(info)"
                },
                {
                    "id": "assetAwareMcp.documents",
                    "name": "Documents",
                    "icon": "$(file-pdf)"
                },
                {
                    "id": "assetAwareMcp.tables",
                    "name": "Tables & Drafts",
                    "icon": "$(table)"
                }
            ]
        },
        "menus": {
            "view/item/context": [
                {
                    "command": "assetAwareMcp.openTableExcel",
                    "when": "view == assetAwareMcp.tables && viewItem == table-item",
                    "group": "inline"
                }
            ],
            "explorer/context": [
                {
                    "command": "assetAwareMcp.openDocxAsDfm",
                    "when": "resourceExtname == .docx",
                    "group": "navigation"
                },
                {
                    "command": "assetAwareMcp.openDocxAsDfm",
                    "when": "resourceExtname == .doc",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "assetAwareMcp.saveDfmToDocx",
                    "when": "resourceExtname == .dfm && assetAwareMcp.dfmTracked",
                    "group": "navigation"
                }
            ]
        },
        "walkthroughs": [
            {
                "id": "assetAwareMcp.welcome",
                "title": "Get Started with Asset-Aware MCP",
                "description": "Set up your Medical RAG MCP Server",
                "steps": [
                    {
                        "id": "assetAwareMcp.setup",
                        "title": "Run Setup Wizard",
                        "description": "Configure your environment and check dependencies.\n[Run Setup Wizard](command:assetAwareMcp.setupWizard)",
                        "media": {
                            "markdown": "resources/walkthrough/setup.md"
                        }
                    },
                    {
                        "id": "assetAwareMcp.configure",
                        "title": "Configure Settings",
                        "description": "Set up your LLM backend and API keys.\n[Open Settings](command:assetAwareMcp.openSettings)",
                        "media": {
                            "markdown": "resources/walkthrough/configure.md"
                        }
                    },
                    {
                        "id": "assetAwareMcp.start",
                        "title": "Start Using",
                        "description": "Begin ingesting documents and querying.\n[Open Copilot Chat](command:workbench.action.chat.open)",
                        "media": {
                            "markdown": "resources/walkthrough/start.md"
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "sync-assets": "node ./scripts/sync-assistant-assets.mjs",
        "sync-assets:check": "node ./scripts/check-sync-assets.mjs",
        "vscode:prepublish": "npm run sync-assets && npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "npm run compile && node ./out/test/runTest.js",
        "test:unit": "npm run compile && mocha --require out/test/unit/setup.js 'out/test/unit/**/*.test.js' --timeout 5000",
        "test:package-contents": "npm run compile && node ./out/test/packageContents.js",
        "test:install-smoke": "npm run compile && node ./out/test/installSmoke.js",
        "test:ci": "npm run sync-assets:check && npm run lint && npm run test:unit && npm run test:package-contents",
        "package": "npm run sync-assets && vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.0.0",
        "@types/sinon": "^21.0.0",
        "@types/vscode": "^1.96.0",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.2.1",
        "eslint": "^9.16.0",
        "mocha": "^10.8.2",
        "sinon": "^21.0.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.51.0"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/u9401066/asset-aware-mcp"
    },
    "bugs": {
        "url": "https://github.com/u9401066/asset-aware-mcp/issues"
    },
    "homepage": "https://github.com/u9401066/asset-aware-mcp#readme",
    "license": "Apache-2.0"
}
